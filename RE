local function getFollowOffsetCFrame(targetRoot)
	if not targetRoot then
		return nil
	end

	if followOffsetMode == "" then
		return targetRoot.CFrame * CFrame.new(0, 0, -3)
	elseif followOffsetMode == "" then
		return targetRoot.CFrame * CFrame.new(0, 8, 1)
	elseif followOffsetMode == "" then
		return targetRoot.CFrame * CFrame.new(-3, 0, 0)
	elseif followOffsetMode == "" then
		return targetRoot.CFrame * CFrame.new(3, 0, 0)
	end

	return targetRoot.CFrame * CFrame.new(0, 0, 3)
end

