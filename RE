local function normalizeKeybindText(textValue)
	local raw = tostring(textValue or ""):lower():gsub("%s+", "")
	local aliases = {
		["rightshift"] = Enum.KeyCode.RightShift,
		["rshift"] = Enum.KeyCode.RightShift,
		["leftshift"] = Enum.KeyCode.LeftShift,
		["lshift"] = Enum.KeyCode.LeftShift,
		["space"] = Enum.KeyCode.Space,
		["spacebar"] = Enum.KeyCode.Space,
		["ctrl"] = Enum.KeyCode.LeftControl,
		["control"] = Enum.KeyCode.LeftControl,
		["leftcontrol"] = Enum.KeyCode.LeftControl,
		["lctrl"] = Enum.KeyCode.LeftControl,
		["rightcontrol"] = Enum.KeyCode.RightControl,
		["rctrl"] = Enum.KeyCode.RightControl,
	}

	if aliases[raw] then
		return aliases[raw]
	end

	for _, keyCode in ipairs(Enum.KeyCode:GetEnumItems()) do
		if keyCode.Name:lower() == raw then
			return keyCode
		end
	end
	return nil
end

local function keybindToLabel(keyCode)
	if keyCode == Enum.KeyCode.Space then return "Space" end
	if keyCode == Enum.KeyCode.LeftControl then return "Ctrl" end
	if keyCode == Enum.KeyCode.RightControl then return "RightCtrl" end
	if keyCode == Enum.KeyCode.RightShift then return "RightShift" end
	if keyCode == Enum.KeyCode.LeftShift then return "LeftShift" end
	return keyCode and keyCode.Name or "None"
end

local function isKeybindPressed(inputKey, bindKey)
	if not bindKey then return false end
	if inputKey == bindKey then return true end
	if bindKey == Enum.KeyCode.LeftControl and inputKey == Enum.KeyCode.RightControl then return true end
	if bindKey == Enum.KeyCode.RightControl and inputKey == Enum.KeyCode.LeftControl then return true end
	return false
end

local function setHubUIVisible(state)
	pcall(function()
		local roots = {}
		if gethui then table.insert(roots, gethui()) end
		local CoreGui = game:GetService("CoreGui")
		local PlayerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
		if CoreGui then table.insert(roots, CoreGui) end
		if PlayerGui then table.insert(roots, PlayerGui) end
		local done = {}
		local keywords = {"rayfield","rnx","rnx hub"}
		for _, root in ipairs(roots) do
			for _, obj in ipairs(root:GetDescendants()) do
				local matched = false
				pcall(function()
					local n = string.lower(obj.Name or "")
					for _, key in ipairs(keywords) do
						if n:find(key, 1, true) then matched = true break end
					end
					if not matched and obj:IsA("TextLabel") then
						local t = string.lower(obj.Text or "")
						if t:find("rnx hub", 1, true) then matched = true end
					end
				end)
				if matched then
					local topGui = obj
					while topGui and topGui.Parent and not topGui:IsA("ScreenGui") do
						topGui = topGui.Parent
					end
					if topGui and topGui:IsA("ScreenGui") and not done[topGui] then
						done[topGui] = true
						topGui.Enabled = state
					end
				end
			end
		end
	end)
end

