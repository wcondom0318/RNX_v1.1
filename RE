local aimToggleSyncing = false
local currentAimTargetPlayer = nil
local currentAimTargetPart = nil
local bothAimFlip = false
local lastBothSwitch = 0
local bothSwitchInterval = 0.03

local function clearCurrentAimTarget()
	currentAimTargetPlayer = nil
	currentAimTargetPart = nil
end

local function getAimBodyPart(char)
	if not char then return nil end
	return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or char:FindFirstChild("HumanoidRootPart")
end

local function getAimTargetPart(char)
	if not char then return nil end

	local head = char:FindFirstChild("Head")
	local body = getAimBodyPart(char)

	if aimTargetPartMode == "Head" then
		return head
	elseif aimTargetPartMode == "Body" then
		return body
	elseif aimTargetPartMode == "Both" then
		local now = tick()

		if now - lastBothSwitch >= bothSwitchInterval then
			lastBothSwitch = now
			bothAimFlip = not bothAimFlip
		end

		if bothAimFlip then
			return head or body
		else
			return body or head
		end
	end

	return head
end

local function isAimPartVisible(targetPart)
	if not targetPart then return false end
	if not aimWallCheck then return true end

	local origin = Camera.CFrame.Position
	local direction = targetPart.Position - origin

	local rayParams = RaycastParams.new()
	rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
	rayParams.FilterType = Enum.RaycastFilterType.Blacklist

	local result = Workspace:Raycast(origin, direction, rayParams)
	if not result then
		return true
	end

	return result.Instance and result.Instance:IsDescendantOf(targetPart.Parent)
end

local function getClosestAimTarget()
	local mousePos = UIS:GetMouseLocation()
	local bestTarget = nil
	local bestDist = math.huge
	local localRoot = getRoot()

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local char = player.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local hrp = char and char:FindFirstChild("HumanoidRootPart")

			if hum and hum.Health > 0 and hrp and localRoot then
				local worldDist = (hrp.Position - localRoot.Position).Magnitude
				if worldDist <= aimMaxDistance then
					local targetPart = getAimTargetPart(char)

					if targetPart and isAimPartVisible(targetPart) then
						local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
						if onScreen then
							local dist2d = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
							if dist2d <= aimFOV and dist2d < bestDist then
								bestDist = dist2d
								bestTarget = {
									Player = player,
									Part = targetPart,
								}
							end
						end
					end
				end
			end
		end
	end

	if bestTarget then
		currentAimTargetPlayer = bestTarget.Player
		currentAimTargetPart = bestTarget.Part
	else
		clearCurrentAimTarget()
	end

	return bestTarget
end

local function aimAtTarget(targetData, hardLock)
	if not targetData or not targetData.Player or not targetData.Part then return end
	local character = targetData.Player.Character
	if not character or not targetData.Part:IsDescendantOf(character) then return end
	local targetPart = targetData.Part

	local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
	if not onScreen then return end

	local current = UIS:GetMouseLocation()
	local goal = Vector2.new(screenPos.X, screenPos.Y)

	if hardLock then
		mousemoverel(goal.X - current.X, goal.Y - current.Y)
	else
		--         
		-- 0.0001 ~ 0.01 =   / 1 = 
		local strengthMultiplier = math.clamp(1 / (aimSmoothness * 120), 0.08, 1)
		local delta = (goal - current) * strengthMultiplier
		mousemoverel(delta.X, delta.Y)
	end
end

