    local PROCESS_INTERVAL  = 0.1
    local lastRangeKillTime = 0
    local underKillEnabled  = false
    local underKillThread   = nil
    local offsetY           = -5.2
    local backOffset        = -0.6
    local switchDelay       = 0.2

    local function startUnderKill()
        if underKillThread then return end
        underKillThread = task.spawn(function()
            local lp   = LocalPlayer
            local char = lp.Character or lp.CharacterAdded:Wait()
            local hrp  = char:WaitForChild("HumanoidRootPart")

            local physConn = RunService.Stepped:Connect(function()
                if not underKillEnabled then return end
                for _, v in pairs(char:GetDescendants()) do
                    if v:IsA("BasePart") then
                        v.CanCollide = false
                        v.AssemblyLinearVelocity = Vector3.zero
                        v.AssemblyAngularVelocity = Vector3.zero
                    end
                end
            end)

            while underKillEnabled do
                local targets = {}
                if killTarget and isTargetValid(killTarget) then
                    table.insert(targets, killTarget)
                else
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr ~= lp and isTargetValid(plr) then
                            table.insert(targets, plr)
                        end
                    end
                end

                for _, plr in pairs(targets) do
                    if not underKillEnabled then break end
                    local targetHRP = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                    if targetHRP then
                        local start = tick()
                        while tick() - start < switchDelay do
                            if not underKillEnabled then break end
                            local behind = targetHRP.CFrame.LookVector * backOffset
                            local pos    = targetHRP.Position + Vector3.new(0, offsetY, 0) + behind
                            local yRot   = math.rad(targetHRP.Orientation.Y + 180)
                            local lieRot = CFrame.Angles(math.rad(-90), 0, 0)
                            hrp.CFrame   = CFrame.new(pos) * CFrame.Angles(0, yRot, 0) * lieRot
                            task.spawn(function() kill(plr) end)
                            RunService.RenderStepped:Wait()
                        end
                    end
                end
                task.wait()
            end

            physConn:Disconnect()
            underKillThread = nil
        end)
    end

