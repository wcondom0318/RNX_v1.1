        part.Name         = "RangeIndicator"
        part.Shape        = Enum.PartType.Cylinder
        part.Size         = Vector3.new(0.3, rangeRadius * 2, rangeRadius * 2)
        part.Anchored     = true
        part.CanCollide   = false
        part.CastShadow   = false
        part.Material     = Enum.Material.Neon
        part.Color        = Color3.fromRGB(255, 0, 0)
        part.Transparency = 0.4
        part.Parent       = workspace
        rangeVisual = part
    end

    local function removeRangeVisual()
        if rangeVisual then rangeVisual:Destroy() rangeVisual = nil end
    end

    local function updateRangeVisual()
        if not rangeVisual then return end
        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local floorY = hrp.Position.Y - 3
        rangeVisual.Size  = Vector3.new(0.3, rangeRadius * 2, rangeRadius * 2)
        rangeVisual.CFrame = CFrame.new(hrp.Position.X, floorY, hrp.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
    end

    local function doKill()
        if not keyInitialized then
            WindUI:Notify({ Title = "킬 오류", Content = "키 초기화 버튼을 먼저 누르세요", Icon = "x", Duration = 3 })
            return
        end
        if not getTool() then
            WindUI:Notify({ Title = "킬 오류", Content = "총을 장착해주세요", Icon = "x", Duration = 3 })
            return
        end
        if killTarget then
            kill(killTarget)
        else
            for _, plr in pairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and isTargetValid(plr) then
                    task.spawn(function() kill(plr) end)
                end
            end
        end
    end

    RunService.Heartbeat:Connect(function()
        if rangeVisual then updateRangeVisual() end
        if not rangeKillEnabled then return end
        if not keyInitialized then return end
        if not getTool() then return end

        local now = tick()
        if now - lastRangeKillTime < 0.1 then return end
        lastRangeKillTime = now

        local char = LocalPlayer.Character
        if not char then return end
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end

        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and isTargetValid(plr) then
                local plrHRP = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
                if plrHRP then
                    local dist = (plrHRP.Position - hrp.Position).Magnitude
                    if dist <= rangeRadius then
                        task.spawn(function() kill(plr) end)
                    end
                end
            end
        end
    end)

