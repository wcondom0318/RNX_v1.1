    end

    local function kill(target)
        if not isTargetValid(target) then return end
        local tool = getTool()
        if not tool then return end
        local Info
        local ok2, result2 = pcall(require, tool.Info)
        if ok2 then Info = result2 else return end
        local k = NextRemoteKey(LocalPlayer)
        if not k then return end

        local char     = target.Character
        local humanoid = char:FindFirstChildOfClass("Humanoid")
        local headPart = char:FindFirstChild("Head")

        local headVec = vector.create(0, 0, 0)
        if headPart then
            local p = headPart.Position
            headVec = vector.create(p.X, p.Y, p.Z)
        end

        local velVec = vector.create(0, 0, 0)
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local vel = hrp.AssemblyLinearVelocity
            velVec = vector.create(vel.X, vel.Y, vel.Z)
        end

        local args = {
            {
                ["damage"]   = Info.damage.headshot,
                ["k"]        = k,
                ["hit_name"] = "Head",
                ["head"]     = headVec,
                ["target"]   = humanoid,
                ["velocity"] = velVec,
                ["tool"]     = tool,
                ["auth"]     = false
            }
        }
        pcall(function() DamageRemote:FireServer(unpack(args)) end)
    end

