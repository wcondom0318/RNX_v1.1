    local function GetPlayerUserId(Player)
        local user_id = Player.UserId
        if #tostring(user_id) ~= 9 then user_id = math.abs(user_id * 100000000) end
        return user_id
    end

    local userid = GetPlayerUserId(LocalPlayer)

    local function initKey()
        if keyInitialized then return end
        pcall(function()
            local retrieved = filtergc("table", { Keys = { "remote_key" } }, true)
            if retrieved then
                KeyTable = retrieved.remote_key
                remote_key = {}
                local initial
                for _, v in pairs(KeyTable) do initial = v break end
                remote_key[userid] = initial
                keyInitialized = true
                WindUI:Notify({ Title = "킬 시스템", Content = "키 초기화 성공", Icon = "check", Duration = 3 })
            else
                WindUI:Notify({ Title = "킬 시스템", Content = "키 획득 실패 - 총 장착 후 재시도", Icon = "x", Duration = 3 })
            end
        end)
    end

    local function ReplaceChar(pos, str, r)
        return str:sub(1, pos-1) .. r .. str:sub(pos+1)
    end

    local function NextRemoteKey(Player)
        local user_id = GetPlayerUserId(Player)
        local key = remote_key[user_id]
        if not key then return nil end
        local a = key:sub(4,4)
        local p = string.byte(key:sub(1,1))
        local s = tonumber(a) + tonumber(a)
        if s > 9 then s = 1 end
        local n = key:gsub(a, tostring(s))
        local h = p + 4 - s
        if h > 90 then h = 65 end
        local n1 = ReplaceChar(1, n, string.char(h))
        remote_key[user_id] = n1
        return n1
    end

