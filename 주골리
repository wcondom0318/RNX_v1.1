    KillSection1:Space()

    KillSection1:Button({
        Title = "킬 실행", Icon = "zap", Justify = "Center",
        Callback = function() task.spawn(doKill) end,
    })
    KillSection1:Space()

    KillSection1:Toggle({
        Title = "자동 킬 ON/OFF", Value = false,
        Callback = function(v)
            autoKillEnabled = v
            WindUI:Notify({ Title = "자동 킬", Content = v and "활성화됨" or "비활성화됨", Icon = v and "check" or "x", Duration = 3 })
            if v then
                task.spawn(function()
                    while autoKillEnabled do doKill() task.wait(PROCESS_INTERVAL) end
                end)
            end
        end,
    })
    KillSection1:Space()

    KillSection1:Toggle({
        Title = "발밑 올킬 ON/OFF", Value = false,
