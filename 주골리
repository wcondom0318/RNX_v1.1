            WindUI:Notify({ Title = "발밑 올킬", Content = v and "활성화됨" or "비활성화됨", Icon = v and "check" or "x", Duration = 3 })
            if v then startUnderKill() end
        end,
    })

    local KillSection2 = KillTab:Section({ Title = "범위 킬 설정" })

    KillSection2:Slider({
