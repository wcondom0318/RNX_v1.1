        if not hrp then return end
        local originalLocation = hrp.CFrame
        SafeNotify("실행", "플링 후 원래 자리로 복귀합니다.", 2)

        for _, target in pairs(Players:GetPlayers()) do
            if target ~= player and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                local tRoot = target.Character.HumanoidRootPart
                hrp.CFrame = tRoot.CFrame * CFrame.new(0, 0, 1)
                hrp.AssemblyLinearVelocity = Vector3.new(99999, 99999, 99999)
                task.wait(0.15)
            end
        end

        hrp.CFrame = originalLocation
        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        SafeNotify("완료", "원래 위치로 복귀했습니다.", 2)
    end})

