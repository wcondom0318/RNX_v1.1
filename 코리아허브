    end})

    TrollTab:CreateButton({Name = "클래식 소드 올킬 (친구보호)", Callback = function()
        SafeRun("Sword Kill GUI", function()
            local active = false
            local guiParent = game:GetService("CoreGui")
            local g = Instance.new("ScreenGui")
            g.Name = "KoreaHubSwordKill"
            g.ResetOnSpawn = false
            g.Parent = guiParent

            local b = Instance.new("TextButton")
            b.Size = UDim2.new(0, 140, 0, 40)
            b.Position = UDim2.new(0.5, -70, 0.85, -20)
            b.Text = "올킬: OFF"
            b.BackgroundColor3 = Color3.new(1, 0, 0)
            b.TextColor3 = Color3.new(1, 1, 1)
            b.Parent = g
            pcall(function() b.Draggable = true end)

            b.MouseButton1Click:Connect(function()
                active = not active
                b.Text = active and "올킬: ON" or "올킬: OFF"
                b.BackgroundColor3 = active and Color3.new(0, 1, 0) or Color3.new(1, 0, 0)
            end)

            RunService.RenderStepped:Connect(function()
                if not active then return end
