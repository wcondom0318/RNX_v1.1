local function sayToAll(message)
    task.spawn(function()
        local TextChatService = game:GetService("TextChatService")
        
        if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
            local textChannels = TextChatService:FindFirstChild("TextChannels")
            if textChannels then
                local rbxGeneral = textChannels:FindFirstChild("RBXGeneral")
                if rbxGeneral then
                    rbxGeneral:SendAsync(message)
                    return
                end
            end
        end
        
        local sayMessageRequest = ReplicatedStorage:FindFirstChild("SayMessageRequest", true)
        if sayMessageRequest and sayMessageRequest:IsA("RemoteEvent") then
            sayMessageRequest:FireServer(message, "All")
            return
        end
        
        pcall(function()
            game:GetService("Players"):Chat(message)
        end)
    end)
end

local function startChatSpam()
    if ChatSpammer.isSending then return end
    
    local message = ChatSpammer.message or "mochi hub"
    local interval = ChatSpammer.interval or 0.5
    local isInfinite = ChatSpammer.isInfinite
    local maxCount = ChatSpammer.count or 10
    
    if interval < 0.05 then interval = 0.05 end
    if interval > 30 then interval = 30 end
    
    ChatSpammer.isSending = true
    ChatSpammer.messageCount = 0
    
    OrionLib:MakeNotification({
        Name = "📨 チャット送信",
        Content = isInfinite and "無限送信を開始しました" or maxCount .. "回の送信を開始しました",
        Time = 2
    })
    
    ChatSpammer.sendLoop = task.spawn(function()
        while ChatSpammer.isSending and (isInfinite or ChatSpammer.messageCount < maxCount) do
            ChatSpammer.messageCount = ChatSpammer.messageCount + 1
            sayToAll(message)
            
            if not isInfinite and ChatSpammer.messageCount >= maxCount then
                break
            end
            
            task.wait(interval)
        end
        
        if ChatSpammer.isSending then
            ChatSpammer.isSending = false
            OrionLib:MakeNotification({
                Name = "📨 チャット送信",
                Content = "送信完了！(" .. ChatSpammer.messageCount .. "回)",
                Time = 2
            })
        end
    end)
end

local function stopChatSpam()
    if not ChatSpammer.isSending then return end
    
    ChatSpammer.isSending = false
    if ChatSpammer.sendLoop then
        task.cancel(ChatSpammer.sendLoop)
        ChatSpammer.sendLoop = nil
    end
    
    OrionLib:MakeNotification({
        Name = "📨 チャット送信",
        Content = "送信を停止しました (" .. ChatSpammer.messageCount .. "回送信)",
        Time = 2
    })
end

