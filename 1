local function ApplyESP(object, isNPC, customName)
    if object:FindFirstChild("OrionESP") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "OrionESP"
    highlight.FillColor = isNPC and Color3.fromRGB(255, 170, 0) or Color3.fromRGB(0, 255, 128)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.4
    highlight.OutlineTransparency = 0
    highlight.Adornee = object
    highlight.Parent = object

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "OrionNameESP"
    billboard.Size = UDim2.new(0, 200, 0, 50)
    billboard.AlwaysOnTop = true
    billboard.ExtentsOffset = Vector3.new(0, 3, 0)
    billboard.Adornee = object:FindFirstChild("Head") or object.PrimaryPart

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = customName or object.Name
    label.TextColor3 = isNPC and Color3.fromRGB(255, 220, 100) or Color3.fromRGB(255, 255, 255)
    label.TextStrokeTransparency = 0
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.TextSize = 14
    label.Font = Enum.Font.SourceSansBold

    label.Parent = billboard
    billboard.Parent = object
end

local function RemoveESP(object)
    if object:FindFirstChild("OrionESP") then object.OrionESP:Destroy() end
    if object:FindFirstChild("OrionNameESP") then object.OrionNameESP:Destroy() end
end

