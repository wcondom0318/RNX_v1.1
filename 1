            task.spawn(function()
                local radius, speed, heightOffset, angle = 19, 12, 0, 0
                while orbitRunning do
                    local target = Players:FindFirstChild(TARGET_PLAYER_NAME)
                    if target and target ~= LocalPlayer then
                        local blobman = SpawnBlobman()
                        if blobman and SetNetworkOwner and createGrabLineEvent and destroyGrabLineEvent then
                            local scriptObj = blobman:FindFirstChild("BlobmanSeatAndOwnerScript")
                            local grabRemote = scriptObj and scriptObj:FindFirstChild("CreatureGrab")
                            local dropRemote = scriptObj and scriptObj:FindFirstChild("CreatureDrop")
                            local lDet = blobman:FindFirstChild("LeftDetector")
                            local rDet = blobman:FindFirstChild("RightDetector")
                            local lWeld = lDet and (lDet:FindFirstChild("LeftWeld") or lDet:FindFirstChild("RigidConstraint"))
                            local rWeld = rDet and (rDet:FindFirstChild("RightWeld") or rDet:FindFirstChild("RigidConstraint"))

                            local blobRoot = blobman:FindFirstChild("HumanoidRootPart") or blobman.PrimaryPart
                            local Det = rDet or lDet
                            local Weld = rWeld or lWeld

                            local tChar = target.Character
                            local tHum = tChar and tChar:FindFirstChild("Humanoid")
                            local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

                            if tChar and tRoot and tHum and tHum.Health > 0 and blobRoot then
                                local bringStart = tick()
                                while tick() - bringStart < 0.35 and orbitRunning do
                                    if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                        local currentTRoot = target.Character.HumanoidRootPart
                                        blobRoot.CFrame = currentTRoot.CFrame
                                        blobRoot.AssemblyLinearVelocity = Vector3.zero
                                        pcall(function()
                                            if Det and grabRemote then grabRemote:FireServer(Det, currentTRoot, Weld) end
                                            createGrabLineEvent:FireServer(currentTRoot, Vector3.zero, currentTRoot.Position, false)
                                            SetNetworkOwner:FireServer(currentTRoot, blobRoot.CFrame)
                                        end)
                                    end
                                    RunService.Heartbeat:Wait()
                                end

                                local lastTime = tick()
                                local lastDropTime = tick()
                                local dropCount = 0
                                local SavedPos = tRoot.CFrame
                                local targetCenterCFrame = SavedPos + Vector3.new(0, 30, 0)

                                while orbitRunning and blobman and blobman.Parent do
                                    if not target or not target.Parent then break end
                                    tChar = target.Character
                                    tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
                                    tHum = tChar and tChar:FindFirstChild("Humanoid")
                                    if not tChar or not tRoot or not tHum or tHum.Health <= 0 then break end

                                    if dropCount < 2 and (tick() - lastDropTime) > 0.8 then
                                        dropCount = dropCount + 1
                                        pcall(function()
                                            local rightWeld = blobman:FindFirstChild("RightDetector") and blobman.RightDetector:FindFirstChild("RightWeld")
                                            if rightWeld and dropRemote then dropRemote:FireServer(rightWeld) end
                                            destroyGrabLineEvent:FireServer(tRoot)
                                        end)
                                        blobRoot.CFrame = SavedPos
                                        RunService.Heartbeat:Wait()
                                        if target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
                                            local currentTRoot = target.Character.HumanoidRootPart
                                            blobRoot.CFrame = currentTRoot.CFrame
                                            pcall(function()
                                                if Det and grabRemote then grabRemote:FireServer(Det, currentTRoot, Weld) end
                                                createGrabLineEvent:FireServer(currentTRoot, Vector3.zero, currentTRoot.Position, false)
                                                SetNetworkOwner:FireServer(currentTRoot, blobRoot.CFrame)
                                            end)
                                        end
                                        lastTime, lastDropTime = tick(), tick()
                                    end

                                    local currentTime = tick()
                                    local dt = currentTime - lastTime
                                    lastTime = currentTime
                                    angle = angle + (speed * dt)

                                    local offsetX = math.cos(angle) * radius
                                    local offsetZ = math.sin(angle) * radius
                                    local blobPos = targetCenterCFrame.Position + Vector3.new(offsetX, heightOffset, offsetZ)

                                    blobRoot.CFrame = CFrame.new(blobPos, targetCenterCFrame.Position)
                                    tRoot.CFrame = targetCenterCFrame

                                    pcall(function()
                                        tHum.PlatformStand = true
                                        tHum.Sit = true
                                        SetNetworkOwner:FireServer(tRoot, targetCenterCFrame)
                                        local rightWeld = blobman:FindFirstChild("RightDetector") and blobman.RightDetector:FindFirstChild("RightWeld")
                                        if rightWeld and dropRemote then dropRemote:FireServer(rightWeld) end
                                        destroyGrabLineEvent:FireServer(tRoot)
                                        if Det and grabRemote then grabRemote:FireServer(Det, tRoot, Weld) end
                                        createGrabLineEvent:FireServer(tRoot, Vector3.zero, targetCenterCFrame.Position, false)
                                    end)
                                    RunService.Heartbeat:Wait()
                                end
                            end
                        end
                    end
                    RunService.Heartbeat:Wait()
                end
            end)
        else
            OrionLib:MakeNotification({ Name = "⏹️ Orbit Stopped", Content = "Orbit attack stopped", Time = 2 })
        end
    end,
})

