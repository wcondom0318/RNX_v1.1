local function getToyModPrimaryPart(model)
    if model.PrimaryPart then return model.PrimaryPart end
    local potentialParts = { "Handle", "Main", "Part", "Base", "Sparkler", "VehicleSeat" }
    for _, partName in ipairs(potentialParts) do
        local part = model:FindFirstChild(partName)
        if part and part:IsA("BasePart") then return part end
    end
    return model:FindFirstChildWhichIsA("BasePart")
end

local function findToyModObjects()
    local toys = {}
    local targetName = ToyModConfig.CurrentObjectID

    for _, item in ipairs(Workspace:GetDescendants()) do
        if item:IsA("Model") then
            local lowerName = string.lower(item.Name)
            if targetName == "Tetracube1" then
                if string.find(lowerName, "tetracube") then table.insert(toys, item) end
            elseif targetName == "🚽 Toilet" then
                if string.find(lowerName, "toilet") then table.insert(toys, item) end
            elseif targetName == "📺 Flatscreen Television" then
                if string.find(lowerName, "television") or string.find(lowerName, "tv") or string.find(lowerName, "flatscreen") then
                    table.insert(toys, item)
                end
            elseif targetName == "💩 Poop" then
                if string.find(lowerName, "poop") or string.find(lowerName, "💩") then table.insert(toys, item) end
            elseif targetName == "🔥 Campfire" then
                if string.find(lowerName, "campfire") then table.insert(toys, item) end
            elseif targetName == "🏮 Paper Lantern" then
                if string.find(lowerName, "paper lantern") or string.find(lowerName, "lantern") then table.insert(toys, item) end
            elseif item.Name == targetName then
                table.insert(toys, item)
            end
        end
    end
    return toys
end

local function attachToyPhysics(part)
    if not part then return nil, nil end
    local existingBG = part:FindFirstChildOfClass("BodyGyro")
    local existingBP = part:FindFirstChildOfClass("BodyPosition")
    if existingBG and existingBP then return existingBG, existingBP end
    if existingBG then existingBG:Destroy() end
    if existingBP then existingBP:Destroy() end

    local BP = Instance.new("BodyPosition")
    local BG = Instance.new("BodyGyro")
    BP.P = 50000
    BP.D = 150
    BP.MaxForce = Vector3.new(1, 1, 1) * 1e12
    BP.Parent = part
    BG.P = 50000
    BG.D = 150
    BG.MaxTorque = Vector3.new(1, 1, 1) * 1e12
    BG.Parent = part
    return BG, BP
end

local function updateToyArtGeometry(dt)
    if ToyModConfig.CurrentMode == "None" then return end

    local targetUser = LocalPlayer
    if ToyModConfig.AttachToTarget and ToyModConfig.TargetName ~= "" then
        local foundPlr = Players:FindFirstChild(ToyModConfig.TargetName)
        if foundPlr then targetUser = foundPlr end
    end
    if not targetUser.Character then return end
    local root = targetUser.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local toys = findToyModObjects()
    if #toys == 0 then return end
    ArtTime = ArtTime + dt * ToyModConfig.Speed
    local useCount = math.min(#toys, ToyModConfig.MaxObjects)

    local customRotation = CFrame.Angles(math.rad(ToyModConfig.RotX), math.rad(ToyModConfig.RotY), math.rad(ToyModConfig.RotZ))
    local verticalPartBase = CFrame.Angles(math.rad(90), 0, 0)

    for i = 1, useCount do
        local toy = toys[i]
        local pPart = getToyModPrimaryPart(toy)
        if pPart then
            for _, c in ipairs(toy:GetChildren()) do
                if c:IsA("BasePart") then
                    c.CanCollide = false
                    c.CanTouch = false
                end
            end
            local bg, bp = attachToyPhysics(pPart)
            if not bp or not bg then continue end

            local targetPos = root.Position
            local targetRot = root.CFrame * verticalPartBase * customRotation
            local mode = ToyModConfig.CurrentMode

            if mode == "NormalWings" then
                local isRightWing = (i % 2 == 0)
                local sideSign = isRightWing and 1 or -1
                local idx = math.floor((i - 1) / 2) + 1
                local totalSide = math.max(1, math.floor(useCount / 2))
                local t = idx / totalSide
                local wingSpread = t * ToyModConfig.Radius * 1.1
                local flap = math.sin(ArtTime * 3.0) * 2.0 * t
                targetPos = root.Position
                    + (root.CFrame.RightVector * wingSpread * sideSign)
                    + (root.CFrame.LookVector * -1.5)
                    + Vector3.new(0, ToyModConfig.Height + (t * 4) + flap, 0)

            elseif mode == "AngelHaloWings" then
                local haloCount = math.min(30, math.floor(useCount * 0.25))
                if i <= haloCount then
                    local haloAngle = (i * math.pi * 2 / haloCount) + (ArtTime * 2.0)
                    local currentHaloRadius = ToyModConfig.HaloSize
                    targetPos = root.Position
                        + (root.CFrame.RightVector * math.cos(haloAngle) * currentHaloRadius)
                        + (root.CFrame.LookVector * math.sin(haloAngle) * currentHaloRadius)
                        + Vector3.new(0, 5.5, 0)
                else
                    local wingIdx = i - haloCount
                    local wingTotal = useCount - haloCount
                    local isRightWing = (wingIdx % 2 == 0)
                    local sideSign = isRightWing and 1 or -1
                    local idx = math.floor((wingIdx - 1) / 2) + 1
                    local totalSide = math.max(1, math.floor(wingTotal / 2))
                    local t = (idx / totalSide) * 0.8 + 0.2
                    local flap = math.sin(ArtTime * 2.5) * 2.0 * t
                    local currentRadius = ToyModConfig.Radius * t * 1.3
                    targetPos = root.Position
                        + (root.CFrame.RightVector * currentRadius * sideSign)
                        + (root.CFrame.LookVector * -1.5)
                        + Vector3.new(0, ToyModConfig.Height + (t * 3.5) + flap, 0)
                end

            elseif mode == "DragonOrbit" then
                local isRightWing = (i % 2 == 0)
                local sideSign = isRightWing and 1 or -1
                local idx = math.floor((i - 1) / 2) + 1
                local totalSide = math.max(1, math.floor(useCount / 2))
                local t = idx / totalSide
                local wingSpread = t * ToyModConfig.Radius * 1.2
                local lagSpacing = idx * 0.20
                local waveClock = ArtTime * 3.5
                local dragonFlap = math.sin(waveClock - lagSpacing) * (2.5 * t + 1.0)
                local dragonWaveZ = math.cos(waveClock * 0.8 - lagSpacing) * (1.8 * t)
                targetPos = root.Position
                    + (root.CFrame.RightVector * wingSpread * sideSign)
                    + (root.CFrame.LookVector * (-1.5 + dragonWaveZ))
                    + Vector3.new(0, ToyModConfig.Height + (t * 2.0) + dragonFlap, 0)

            elseif mode == "Tornado" then
                local ratio = i / useCount
                local angle = (ratio * math.pi * 12) + (ArtTime * 4.0)
                local currentRadius = ratio * ToyModConfig.Radius
                local heightOffset = (ratio - 0.5) * 25 + ToyModConfig.Height
                local offsetX = math.cos(angle) * currentRadius
                local offsetZ = math.sin(angle) * currentRadius
                targetPos = root.Position
                    + (root.CFrame.RightVector * offsetX)
                    + (root.CFrame.LookVector * offsetZ)
                    + Vector3.new(0, heightOffset, 0)
                targetRot = CFrame.lookAt(targetPos, root.Position) * verticalPartBase * customRotation

            elseif mode == "Circle" then
                local angle = (i * math.pi * 2 / useCount) + ArtTime
                local offsetX = math.cos(angle) * ToyModConfig.Radius
                local offsetZ = math.sin(angle) * ToyModConfig.Radius
                targetPos = root.Position
                    + (root.CFrame.RightVector * offsetX)
                    + (root.CFrame.LookVector * offsetZ)
                    + Vector3.new(0, ToyModConfig.Height, 0)
                targetRot = CFrame.lookAt(targetPos, root.Position) * verticalPartBase * customRotation
            end

            bp.Position = targetPos
            bg.CFrame = targetRot
        end
    end
end

local function setToyModMode(mode)
    ToyModConfig.CurrentMode = mode
    if mode ~= "None" then
        if not ArtLoopConn then
            ArtLoopConn = RunService.RenderStepped:Connect(updateToyArtGeometry)
        end
    else
        if ArtLoopConn then
            ArtLoopConn:Disconnect()
            ArtLoopConn = nil
        end
    end
end

