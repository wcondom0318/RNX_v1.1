local function resetGraphicsEffects()
    local lighting = game:GetService("Lighting")
    for _, v in pairs(lighting:GetChildren()) do
        if v:IsA("ColorCorrectionEffect") or v:IsA("BloomEffect") or v:IsA("SunRaysEffect") or v:IsA("Atmosphere") or v:IsA("Sky") then
            v:Destroy()
        end
    end
    Instance.new("Sky", lighting)
    return lighting
end

local function applyGraphicsStyle(styleType)
    local lighting = resetGraphicsEffects()

    if styleType == "Realistic" then
        local terrain = Workspace:FindFirstChildOfClass("Terrain")
