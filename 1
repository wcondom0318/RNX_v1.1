local function applyHollowPurpleKnockback()
    if not HollowPurple.knockbackEnabled then return end
    
    for _, dice in ipairs(HollowPurple.AllDice) do
        if dice and dice.Parent then
            pcall(function()
                local touchConnection
                touchConnection = dice.Touched:Connect(function(hit)
                    if hit.Parent and hit.Parent:FindFirstChild("Humanoid") then
                        local player = Players:GetPlayerFromCharacter(hit.Parent)
                        if player and player ~= LocalPlayer then
                            local humanoid = hit.Parent:FindFirstChild("Humanoid")
                            local rootPart = hit.Parent:FindFirstChild("HumanoidRootPart")
                            
                            if humanoid and rootPart then
                                local direction = (rootPart.Position - dice.Position).Unit
                                local force = direction * 200
                                
                                local bv = Instance.new("BodyVelocity")
                                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                                bv.Velocity = force
                                bv.Parent = rootPart
                                
                                Debris:AddItem(bv, 0.3)
                            end
                        end
                    end
                end)
                
                task.delay(2, function()
                    if touchConnection then
                        touchConnection:Disconnect()
                    end
                end)
            end)
        end
    end
end

local function executeHollowPurpleShot()
    if HollowPurple.isAttacking or not HollowPurple.Enabled then return end
    
    HollowPurple.isAttacking = true
    HollowPurple.attackPhase = "Charging"
    
    OrionLib:MakeNotification({
        Name = "Hollow Purple",
        Content = "チャージ中...",
        Time = 4
    })
    
    task.spawn(function()
        local startCol = Color3.new(1, 0, 0)
        local purple = Color3.fromRGB(150, 0, 255)
        
        for i = 0, 1, 0.05 do
            if not HollowPurple.Enabled or not HollowPurple.isAttacking or HollowPurple.HyperMode then break end
            setHollowPurpleLineColor(startCol:Lerp(purple, i))
            task.wait(0.1)
        end
    end)
    
    task.delay(4, function()
        if not HollowPurple.Enabled then return end
        HollowPurple.attackPhase = "Fired"
        
        OrionLib:MakeNotification({
            Name = "Hollow Purple",
            Content = "発射！",
            Time = 2
        })
        
        applyHollowPurpleKnockback()
        
        task.wait(2)
        HollowPurple.attackPhase = "Normal"
        HollowPurple.isAttacking = false
    end)
end

local function startHollowPurpleMainLoop()
    if HollowPurple.MainLoopConnection then return end
    
    HollowPurple.MainLoopConnection = RunService.PreSimulation:Connect(function()
        if not HollowPurple.Enabled then return end
        
        local char = LocalPlayer.Character
        local torso = char and char:FindFirstChild("Torso")
        if not torso then return end
        
        local t = tick()
        local cf = torso.CFrame
        
        if HollowPurple.HyperMode and not HollowPurple.isAttacking then
            setHollowPurpleLineColor(Color3.fromHSV((t * 0.5) % 1, 1, 1))
        end
        
        if HollowPurple.attackPhase == "Normal" then
            for i, dice in ipairs(HollowPurple.LeftDice) do
                if dice and dice.Parent then
                    local bp = dice:FindFirstChild("HollowDiceBP")
                    if bp then
                        local angle = (t * 5) + (i * (math.pi * 2 / #HollowPurple.LeftDice))
                        bp.Position = (cf.Position - cf.RightVector * 8) + 
                                      (cf.UpVector * math.sin(angle) * 2) + 
                                      (cf.LookVector * math.cos(angle) * 2)
                    end
                end
            end
            
            for i, dice in ipairs(HollowPurple.RightDice) do
                if dice and dice.Parent then
                    local bp = dice:FindFirstChild("HollowDiceBP")
                    if bp then
                        local angle = (t * 5) + (i * (math.pi * 2 / #HollowPurple.RightDice))
                        bp.Position = (cf.Position + cf.RightVector * 8) + 
                                      (cf.UpVector * math.sin(angle) * 2) + 
                                      (cf.LookVector * math.cos(angle) * 2)
                    end
                end
            end
            
        elseif HollowPurple.attackPhase == "Charging" then
            local frontPos = cf.Position + (cf.LookVector * 6)
            for i, dice in ipairs(HollowPurple.AllDice) do
                if dice and dice.Parent then
                    local bp = dice:FindFirstChild("HollowDiceBP")
                    if bp then
                        local angle = (t * 10) + (i * (math.pi * 2 / #HollowPurple.AllDice))
                        bp.Position = frontPos + 
                                      (cf.RightVector * math.sin(angle) * 3) + 
                                      (cf.UpVector * math.cos(angle) * 3)
                    end
                end
            end
            
        elseif HollowPurple.attackPhase == "Fired" then
            for _, dice in ipairs(HollowPurple.AllDice) do
                if dice and dice.Parent then
                    local bp = dice:FindFirstChild("HollowDiceBP")
                    if bp then
                        bp.Position = bp.Position + (cf.LookVector * 5)
                    end
                end
            end
        end
    end)
end

