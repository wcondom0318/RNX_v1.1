local chamsHL = {}
local chamsEnabled, chamsVisOnly, chamsAlpha = false, false, 50
local function cleanChams() for _,h in pairs(chamsHL) do pcall(function()h:Destroy()end) end; chamsHL={} end

local function applyChams()
    cleanChams()
    if not chamsEnabled then return end
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer then continue end
        
        if espTeamFilter ~= "전체 (All)" and (p.Team == nil or p.Team.Name ~= espTeamFilter) then continue end
        
        local char = p.Character; if not char then continue end
        local h = Instance.new("Highlight")
        h.FillColor = Color3.fromRGB(255,60,60); h.OutlineColor = Color3.new(1,1,1)
        h.FillTransparency = 1 - (chamsAlpha/100); h.OutlineTransparency = 0
        h.DepthMode = chamsVisOnly and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = char; h.Parent = char; chamsHL[p] = h
    end
end

local function setupChamsForPlayer(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        if chamsEnabled then applyChams() end
    end)
end
for _, p in ipairs(Players:GetPlayers()) do setupChamsForPlayer(p) end
Players.PlayerAdded:Connect(setupChamsForPlayer)

