        local aimCenter = getAimCenter()
        local closestTarget = nil
        local lowestScore = math.huge 
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if myRoot then
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid").Health > 0 then
                    local head = p.Character.Head
                    local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        local mouseDistance = (Vector2.new(screenPoint.X, screenPoint.Y) - aimCenter).Magnitude
                        if mouseDistance <= FOVRadius then
                            local score = mouseDistance + ((head.Position - myRoot.Position).Magnitude * 0.8)
                            if score < lowestScore then lowestScore = score; closestTarget = head end
                        end
                    end
                end
            end
        end
        CurrentTarget = closestTarget
    else
        CurrentTarget = nil
    end
end)

