local InfAmmoEnabled = false
local NoRecoilEnabled = false
local RapidFireEnabled = false
local RapidFireMult = 5

local function applyWeaponMods()
    for _, t in ipairs(getreg()) do
        if type(t) == "table" then
            if rawget(t, "max_ammo") ~= nil or rawget(t, "_orig_max_ammo") ~= nil then
                if not rawget(t, "_orig_max_ammo") then rawset(t, "_orig_max_ammo", rawget(t, "max_ammo")) end
                if not rawget(t, "_orig_current_ammo") then rawset(t, "_orig_current_ammo", rawget(t, "current_ammo")) end
                if not rawget(t, "_orig_reload_time") then rawset(t, "_orig_reload_time", rawget(t, "reload_time")) end
                
                if InfAmmoEnabled then
                    rawset(t, "max_ammo", math.huge) 
                    rawset(t, "current_ammo", math.huge)
                    rawset(t, "reload_time", 0)
                else
                    rawset(t, "max_ammo", rawget(t, "_orig_max_ammo"))
                    rawset(t, "current_ammo", rawget(t, "_orig_current_ammo"))
                    rawset(t, "reload_time", rawget(t, "_orig_reload_time"))
                end
            end
            
            if rawget(t, "Ammo") ~= nil or rawget(t, "_orig_Ammo") ~= nil then
                if not rawget(t, "_orig_Ammo") then rawset(t, "_orig_Ammo", rawget(t, "Ammo")) end
                if InfAmmoEnabled then
                    rawset(t, "Ammo", math.huge)
                else
                    rawset(t, "Ammo", rawget(t, "_orig_Ammo"))
                end
            end
            
            local sp = rawget(t, "spread")
            if type(sp) == "table" then 
                if not rawget(sp, "_orig_min") then rawset(sp, "_orig_min", rawget(sp, "min")) end
                if not rawget(sp, "_orig_max") then rawset(sp, "_orig_max", rawget(sp, "max")) end
                
                if NoRecoilEnabled then
                    rawset(sp, "min", 0); rawset(sp, "max", 0); rawset(sp, "running", 0) 
                else
                    if rawget(sp, "_orig_min") then rawset(sp, "min", rawget(sp, "_orig_min")) end
                    if rawget(sp, "_orig_max") then rawset(sp, "max", rawget(sp, "_orig_max")) end
                end
            end
            
            local rc = rawget(t, "recoil")
            if type(rc) == "table" then 
                if not rawget(rc, "_orig_rotation") then rawset(rc, "_orig_rotation", rawget(rc, "rotation")) end
                if NoRecoilEnabled then
                    rawset(rc, "rotation", 0)
                    local dir = rawget(rc, "dir")
                    if type(dir) == "table" then 
                        if not rawget(dir, "_orig_X") then rawset(dir, "_orig_X", rawget(dir, "X")) end
                        if not rawget(dir, "_orig_Y") then rawset(dir, "_orig_Y", rawget(dir, "Y")) end
                        rawset(dir, "X", {0,0}); rawset(dir, "Y", {0,0}) 
                    end
                else
                    if rawget(rc, "_orig_rotation") then rawset(rc, "rotation", rawget(rc, "_orig_rotation")) end
                    local dir = rawget(rc, "dir")
                    if type(dir) == "table" then 
                        if rawget(dir, "_orig_X") then rawset(dir, "X", rawget(dir, "_orig_X")) end
                        if rawget(dir, "_orig_Y") then rawset(dir, "Y", rawget(dir, "_orig_Y")) end
                    end
                end
            end

            if rawget(t, "fire_delay") or rawget(t, "firerate") or rawget(t, "rpm") or rawget(t, "rate") or rawget(t, "FireRate") or rawget(t, "Cooldown") then
                for _, key in ipairs({"fire_delay", "firerate", "rpm", "rate", "FireRate", "Cooldown"}) do
                    local v = rawget(t, key)
                    if type(v) == "number" or rawget(t, "_orig_"..key) ~= nil then
                        if not rawget(t, "_orig_"..key) then rawset(t, "_orig_"..key, v) end
                        if RapidFireEnabled then
                            if key == "rpm" or key == "rate" or key == "FireRate" then
                                rawset(t, key, rawget(t, "_orig_"..key) * RapidFireMult)
                            else
                                rawset(t, key, rawget(t, "_orig_"..key) / RapidFireMult)
                            end
                        else
                            rawset(t, key, rawget(t, "_orig_"..key))
                        end
                    end
                end
            end
        end
    end
end

