local AATime = 0

RunService.RenderStepped:Connect(function(dt)
    if not AntiAimEnabled then return end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    AATime = AATime + dt * AntiAimSpeed
    local pos = hrp.CFrame.Position
    
    if AntiAimType == "Spin" then
        hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, AATime, 0)
    elseif AntiAimType == "Jitter" then
        local flip = (math.floor(AATime * 2) % 2 == 0) and 0 or math.rad(180)
        local _, cy, _ = hrp.CFrame:ToEulerAnglesYXZ()
        hrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, cy + flip, 0)
    end
end)

