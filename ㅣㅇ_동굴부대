local GodModEnabled = false
local godModConns = {}
local blacklist = { ["수갑"] = true, ["Handcuffs"] = true, }

local function applyGodMod(tool)
    if not tool:IsA("Tool") or blacklist[tool.Name] then return end
    
    local module = tool:FindFirstChildWhichIsA("ModuleScript", true)
    if module then
        local success, config = pcall(require, module)
        if not success then return end

        if GodModEnabled then
            if config.damage then
                if not config._orig_damage_max then config._orig_damage_max = config.damage.max end
                if not config._orig_damage_min then config._orig_damage_min = config.damage.min end
                if not config._orig_damage_headshot then config._orig_damage_headshot = config.damage.headshot end
                
                config.damage.max = 2009523
                config.damage.min = 2009523
                if config.damage.headshot then config.damage.headshot = 2009523 end
            end
            if config.Damage then 
                if not config._orig_Damage then config._orig_Damage = config.Damage end
                config.Damage = 2009523 
            end
            tool:SetAttribute("Modded", true)
        else
            if config.damage then
                if config._orig_damage_max then config.damage.max = config._orig_damage_max end
                if config._orig_damage_min then config.damage.min = config._orig_damage_min end
                if config._orig_damage_headshot then config.damage.headshot = config._orig_damage_headshot end
            end
            if config.Damage and config._orig_Damage then 
                config.Damage = config._orig_Damage 
            end
            tool:SetAttribute("Modded", false)
        end
    end
end

