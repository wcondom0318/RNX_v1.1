local function getTarget(fovRadius)
    local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP then return nil end
    
    local aimCenter = getAimCenter()
    local cx, cy = aimCenter.X, aimCenter.Y
    local best, bestDist = nil, fovRadius or math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local hum = p.Character:FindFirstChild("Humanoid")
        local hrp = p.Character:FindFirstChild("Head") or p.Character:FindFirstChild("HumanoidRootPart")
        if not hum or hum.Health <= 0 or not hrp then continue end

        local screen, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if onScreen then
            local dist = math.sqrt((screen.X - cx)^2 + (screen.Y - cy)^2)
            if dist < bestDist then bestDist = dist; best = hrp end
        end
    end
    return best
end

