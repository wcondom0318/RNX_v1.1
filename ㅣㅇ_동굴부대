local function startESP()
    cleanESP()
    local function addP(p)
        if p==LocalPlayer then return end
        espObjs[p]={
            box   =newD("Square",{Visible=false,Color=Color3.fromRGB(255,60,60),Thickness=1.5,Filled=false}),
            fill  =newD("Square",{Visible=false,Color=Color3.fromRGB(255,60,60),Filled=true,Transparency=0.7}),
            name  =newD("Text",  {Visible=false,Color=Color3.new(1,1,1),Size=13,Outline=true,OutlineColor=Color3.new(0,0,0),Center=true}),
            hbg   =newD("Square",{Visible=false,Color=Color3.fromRGB(30,30,30),Filled=true}),
            hfg   =newD("Square",{Visible=false,Filled=true}),
            dist  =newD("Text",  {Visible=false,Color=Color3.fromRGB(180,180,180),Size=11,Outline=true,OutlineColor=Color3.new(0,0,0),Center=true}),
            tracer=newD("Line",  {Visible=false,Color=Color3.fromRGB(255,200,0),Thickness=1}),
        }
    end
    for _,p in ipairs(Players:GetPlayers()) do addP(p) end
    Players.PlayerAdded:Connect(addP)
    Players.PlayerRemoving:Connect(function(p)
        if espObjs[p] then for _,d in pairs(espObjs[p]) do pcall(function()d:Remove()end) end; espObjs[p]=nil end
    end)
    getgenv()._espConn = RunService.RenderStepped:Connect(function()
        if not espEnabled then for _,o in pairs(espObjs) do hideO(o) end return end
        local myHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        for _,p in ipairs(Players:GetPlayers()) do
            if p==LocalPlayer then continue end
            local o = espObjs[p]; if not o then continue end
            
            if espTeamFilter ~= "전체 (All)" and (p.Team == nil or p.Team.Name ~= espTeamFilter) then
                hideO(o); continue
            end

            local char = p.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            if not hrp or not hum or hum.Health<=0 then hideO(o); continue end
            if myHRP and (hrp.Position-myHRP.Position).Magnitude > espMaxDist then hideO(o); continue end
            local rs,rv = Camera:WorldToViewportPoint(hrp.Position)
            local ts,_ = Camera:WorldToViewportPoint(hrp.Position+Vector3.new(0,3.2,0))
            local bs,_ = Camera:WorldToViewportPoint(hrp.Position-Vector3.new(0,3.0,0))
            if not rv then hideO(o); continue end
            local h = math.abs(ts.Y-bs.Y); local w = h*0.55; local x = rs.X
            if espBox then
                o.box.Visible=true; o.box.Size=Vector2.new(w,h); o.box.Position=Vector2.new(x-w/2,ts.Y); o.box.Thickness=espBoxThick
            else o.box.Visible=false end
            if espFill then
                o.fill.Visible=true; o.fill.Size=Vector2.new(w,h); o.fill.Position=Vector2.new(x-w/2,ts.Y)
            else o.fill.Visible=false end
            if espName then
                o.name.Visible=true; o.name.Text=p.DisplayName; o.name.Position=Vector2.new(x,ts.Y-16); o.name.Size=espTextSize
            else o.name.Visible=false end
            if espDist then
                local dist = myHRP and math.floor((hrp.Position-myHRP.Position).Magnitude) or 0
                o.dist.Visible=true; o.dist.Text=dist.."m"; o.dist.Position=Vector2.new(x,bs.Y+2)
            else o.dist.Visible=false end
            if espHealth then
                local hp = math.clamp(hum.Health/hum.MaxHealth,0,1)
                local bx = x-w/2-5
                o.hbg.Visible=true; o.hbg.Size=Vector2.new(3,h); o.hbg.Position=Vector2.new(bx-1.5,ts.Y)
                o.hfg.Visible=true; o.hfg.Size=Vector2.new(3,h*hp); o.hfg.Position=Vector2.new(bx-1.5,ts.Y+h*(1-hp))
                o.hfg.Color = Color3.fromHSV(hp*0.33,1,1)
            else o.hbg.Visible=false; o.hfg.Visible=false end
            if espTracer then
                local vp = Camera.ViewportSize
                o.tracer.Visible=true; o.tracer.From=Vector2.new(vp.X/2,vp.Y); o.tracer.To=Vector2.new(x,bs.Y); o.tracer.Thickness=espBoxThick
            else o.tracer.Visible=false end
        end
    end)
end

