local function getPlayerByName(name)
	if not name or name == "" then return nil end
	name = tostring(name)

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Name:lower() == name:lower() or plr.DisplayName:lower() == name:lower() then
			return plr
		end
	end

	local clean = name:gsub("@", "")
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Name:lower() == clean:lower() or plr.DisplayName:lower() == clean:lower() then
			return plr
		end
	end
	return nil
end

local function getSortedPlayersByDistance()
	local myRoot = getRoot()
	local data = {}

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local dist = math.huge

			if myRoot and hrp then
				dist = (myRoot.Position - hrp.Position).Magnitude
			end

			table.insert(data, {
				Player = plr,
				Distance = dist
			})
		end
	end

	table.sort(data, function(a, b)
		return a.Distance < b.Distance
	end)
	return data
end

local function getPlayerDisplayOptions()
	local options = {}
	for _, info in ipairs(getSortedPlayersByDistance()) do
		local plr = info.Player
		table.insert(options, string.format("%s (@%s)", plr.DisplayName, plr.Name))
	end
	return options
end

local function getPlayerFromDisplayOption(option)
	if not option then return nil end
	local username = tostring(option):match("@([%w_]+)")
	if username then
		return getPlayerByName(username)
	end
	return getPlayerByName(option)
end

