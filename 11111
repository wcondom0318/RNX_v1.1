local function refreshAllESP()
	for plr in pairs(espData) do
		removeESPForPlayer(plr)
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			createESPForPlayer(plr)
		end
	end
end

local function updateESPForPlayer(plr)
	local data = espData[plr]
	if not data then
		createESPForPlayer(plr)
		data = espData[plr]
	end
	if not data then return end

	local valid = plr.Parent and data.char and data.char.Parent and data.hrp and data.hrp.Parent and data.hum and data.hum.Parent and data.head and data.head.Parent
	if not valid then
		removeESPForPlayer(plr)
		return
	end

	local localChar = getCharacter()
	local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
	local withinRange = false
	if localHrp then
		withinRange = (data.hrp.Position - localHrp.Position).Magnitude <= espMaxDist
	end

	local visible = espEnabled and data.hum.Health > 0 and withinRange
	data.bill.Enabled = visible
	data.nameLabel.Visible = espNameEnabled and visible
	data.healthBack.Visible = espHealthEnabled and visible
	data.distLabel.Visible = espDistanceEnabled and visible

	if data.highlight then
		data.highlight.Enabled = espHighlightEnabled and visible
	end

	if data.selectionBox then
		data.selectionBox.Visible = espBoxEnabled and visible
	end

	if visible then
		data.nameLabel.Text = plr.DisplayName .. " (@" .. plr.Name .. ")"

		local pct = math.clamp(data.hum.Health / math.max(data.hum.MaxHealth, 1), 0, 1)
		data.healthBar.Size = UDim2.new(pct, 0, 1, 0)
		data.healthBar.BackgroundColor3 = Color3.new(math.clamp(2 * (1 - pct), 0, 1), math.clamp(2 * pct, 0, 1), 0.1)

		if localHrp then
			local dist = math.floor((data.hrp.Position - localHrp.Position).Magnitude)
			data.distLabel.Text = tostring(dist) .. " studs"
		end
	end
end

