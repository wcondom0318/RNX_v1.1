local function saveSettingsToFile()
	if not executorSupportsSettingsIO() then
		notify("설정 저장", "이 실행기는 writefile/readfile 저장을 지원하지 않음", 4)
		return false
	end

	local writefileFn = getWritableFunction("writefile")
	local ok, err = pcall(function()
		writefileFn(SETTINGS_FILE, HttpService:JSONEncode(buildSettingsPayload()))
	end)
	if ok then
		notify("💾 설정 저장", "현재 설정 저장 완료", 3)
		return true
	end

	notify("💾 설정 저장", "저장 실패: " .. tostring(err), 4)
	return false
end

local function loadSettingsFromFile(showNotify)
	if not executorSupportsSettingsIO() then
		notify("📂 설정 불러오기", "이 실행기는 파일 불러오기를 지원하지 않음", 4)
		return false
	end

	local readfileFn = getWritableFunction("readfile")
	local isfileFn = getWritableFunction("isfile")
	if isfileFn then
		local okExists, exists = pcall(function()
			return isfileFn(SETTINGS_FILE)
		end)
		if okExists and not exists then
			notify("📂 설정 불러오기", "저장된 설정 파일이 없음", 3)
			return false
		end
	end

	local ok, rawOrErr = pcall(function()
		return readfileFn(SETTINGS_FILE)
	end)
	if not ok then
		notify("📂 설정 불러오기", "읽기 실패: " .. tostring(rawOrErr), 4)
		return false
	end

	local okDecode, decoded = pcall(function()
		return HttpService:JSONDecode(rawOrErr)
	end)
	if not okDecode or type(decoded) ~= "table" then
		notify("📂 설정 불러오기", "설정 파일 형식이 잘못됨", 4)
		return false
	end

	applySettingsToUI(decoded, showNotify ~= false)
	return true
end

