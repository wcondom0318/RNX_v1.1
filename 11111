local function getFollowOffsetCFrame(targetRoot)
	if not targetRoot then
		return nil
	end

	if followOffsetMode == "앞" then
		return targetRoot.CFrame * CFrame.new(0, 0, -3)
	elseif followOffsetMode == "위" then
		return targetRoot.CFrame * CFrame.new(0, 8, 6)
	elseif followOffsetMode == "왼쪽" then
		return targetRoot.CFrame * CFrame.new(-3, 0, 0)
	elseif followOffsetMode == "오른쪽" then
		return targetRoot.CFrame * CFrame.new(3, 0, 0)
	end

	return targetRoot.CFrame * CFrame.new(0, 0, 3)
end

local function getFollowOffsetLabel()
	return tostring(followOffsetMode or "뒤")
end

local function startFollow(targetPlr)
	stopFollow()
