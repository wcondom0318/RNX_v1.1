local function startFly()
	stopFly()

	local root = getRoot()
	local hum = getHumanoid()
	if not root or not hum then return end

	flyEnabled = true
	hum.PlatformStand = true
	hum.AutoRotate = false

	flyBV = Instance.new("BodyVelocity")
	flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
	flyBV.P = 5e4
	flyBV.Velocity = Vector3.zero
	flyBV.Parent = root

	flyBG = Instance.new("BodyGyro")
	flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
	flyBG.P = 9e4
	flyBG.D = 1200
	flyBG.CFrame = Camera.CFrame
	flyBG.Parent = root

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flyEnabled or not accessGranted or hubClosed then return end

		local currentRoot = getRoot()
		local currentHum = getHumanoid()
		if not currentRoot or not currentHum then return end

		local camCF = Camera.CFrame
		local look = camCF.LookVector
		local right = camCF.RightVector
		local moveDir = Vector3.zero

		if moveKeys.W then moveDir += look end
		if moveKeys.S then moveDir -= look end
		if moveKeys.A then moveDir -= right end
		if moveKeys.D then moveDir += right end
		if moveKeys.Ctrl then moveDir -= Vector3.new(0, 1, 0) end
		if moveKeys.Space then moveDir += Vector3.new(0, 1, 0) end

		if moveDir.Magnitude > 0 then
			moveDir = moveDir.Unit * flySpeed
		end

		flyBV.Velocity = moveDir
		flyBG.CFrame = camCF
		currentHum.PlatformStand = true
	end)
