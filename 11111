local KORBLOX_R15_UPPERLEG_TEXTURE_ID = "http://roblox.com/asset/?id=902843398"
local KORBLOX_DARK_GREY_COLOR = Color3.fromRGB(64, 64, 64)

local function applyKorbloxVisuals()
	local char = getCharacter()
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	if hum.RigType == Enum.HumanoidRigType.R15 then
		local rf = char:FindFirstChild("RightFoot")
		local rl = char:FindFirstChild("RightLowerLeg")
		local ru = char:FindFirstChild("RightUpperLeg")

		if ru and rl and rf then
			rf.Transparency = 1
			rl.Transparency = 1
			ru.MeshId = KORBLOX_R15_UPPERLEG_MESH_ID
			ru.TextureID = KORBLOX_R15_UPPERLEG_TEXTURE_ID
			ru.Color = Color3.new(1, 1, 1)
			ru.Transparency = 0
		end
	else
		local rightLeg = char:FindFirstChild("Right Leg")
		if rightLeg then
			for _, v in ipairs(char:GetChildren()) do
				if v:IsA("CharacterMesh") and v.BodyPart == Enum.BodyPart.RightLeg then
					v:Destroy()
				end
			end

			local mesh = rightLeg:FindFirstChildOfClass("SpecialMesh")
			if not mesh then
				mesh = Instance.new("SpecialMesh")
				mesh.Parent = rightLeg
			end

			rightLeg.Color = KORBLOX_DARK_GREY_COLOR
			rightLeg.Transparency = 0
			mesh.MeshType = Enum.MeshType.FileMesh
			mesh.MeshId = KORBLOX_MESH_ID
			mesh.TextureId = KORBLOX_TEXTURE_ID
			mesh.Scale = Vector3.new(1, 1, 1)
		end
	end
end

local function applyKorblox(state)
	if not accessGranted then
		return
	end

	if state then
		local ok, err = pcall(function()
			korbloxEnabled = true
			applyKorbloxVisuals()
		end)

		if ok then
			notify("코블록스", "ON", 3)
		else
			korbloxEnabled = false
			notify("코블록스", "실행 실패: " .. tostring(err), 4)
			pcall(function()
				if KorbloxToggle then
					KorbloxToggle:Set(false)
				end
			end)
		end
	else
		korbloxEnabled = false
		notify("코블록스", "OFF - 원래 모습은 리스폰 후 복원", 3)
	end
end

