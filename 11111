	if input.KeyCode == Enum.KeyCode.D then moveKeys.D = false end
	if input.KeyCode == Enum.KeyCode.Space then moveKeys.Space = false end
	if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then moveKeys.Ctrl = false end
end)

shutdownHub = function()
	if hubClosed then return end
	hubClosed = true

	accessGranted = false
	flyEnabled = false
	runEnabled = false
	infJumpEnabled = false
	jumpHeightEnabled = false
	espEnabled = false
	noclipEnabled = false
	followEnabled = false
	clickTeleportEnabled = false
	invisEnabled = false
	aimEnabled = false
	AntiAfkEnabled = false
	AntiKnockbackEnabled = false
	FullBrightEnabled = false
	FPSBoostEnabled = false
	HighQualityEnabled = false
	thirdPersonEnabled = false
	headlessEnabled = false
	korbloxEnabled = false

	for k in pairs(moveKeys) do
		moveKeys[k] = false
	end

	pcall(stopFly)
	pcall(stopRunBoost)
	pcall(stopESP)
	pcall(stopFollow)
	pcall(stopAim)
	pcall(stopNoclipLoop)
	pcall(restoreCollisionState)
	pcall(function() applyInvisibility(false) end)
	pcall(applyJumpHeight)
	pcall(applyCameraFOV)
	pcall(function() applyThirdPerson(false) end)
	pcall(function() applyFullBright(false) end)
	pcall(restoreGraphicsDefaults)

	pcall(function()
		local hum = getHumanoid()
		local root = getRoot()
		if hum then hum.PlatformStand = false hum.WalkSpeed = 16 hum.UseJumpPower = originalUseJumpPower hum.JumpPower = originalJumpPower hum.JumpHeight = originalJumpHeight end
		if root then root.AssemblyLinearVelocity = Vector3.zero end
	end)

	pcall(function()
		if fovCircle then
			fovCircle.Visible = false
			if fovCircle.Remove then fovCircle:Remove() end
		end
	end)

	pcall(function()
		local backpack = LocalPlayer and LocalPlayer:FindFirstChild("Backpack")
		if backpack then
			local tool = backpack:FindFirstChild("TP Tool")
			if tool then tool:Destroy() end
		end
	end)

	pcall(function()
		local char = LocalPlayer and LocalPlayer.Character
		if char then
			local tool2 = char:FindFirstChild("TP Tool")
			if tool2 then tool2:Destroy() end
		end
	end)

	pcall(function()
		if Window and Window.Destroy then Window:Destroy() end
	end)
	pcall(function()
		if Rayfield and Rayfield.Destroy then Rayfield:Destroy() end
	end)

	task.defer(function()
		pcall(function()
			local roots = {}
			if gethui then table.insert(roots, gethui()) end
			local CoreGui = game:GetService("CoreGui")
			local PlayerGui = LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui")
			if CoreGui then table.insert(roots, CoreGui) end
			if PlayerGui then table.insert(roots, PlayerGui) end
			local keywords = {"rayfield","rnx","rnx hub"}
			for _, root in ipairs(roots) do
				for _, obj in ipairs(root:GetDescendants()) do
					local destroyIt = false
					pcall(function()
						local n = string.lower(obj.Name or "")
						for _, key in ipairs(keywords) do
							if n:find(key, 1, true) then destroyIt = true break end
						end
					end)
					if not destroyIt and obj:IsA("TextLabel") then
						pcall(function()
							local t = string.lower(obj.Text or "")
							if t:find("rnx hub", 1, true) then destroyIt = true end
						end)
					end
					if destroyIt then
						pcall(function()
							local topGui = obj
							while topGui and topGui.Parent and not topGui:IsA("ScreenGui") do
								topGui = topGui.Parent
							end
							if topGui and topGui:IsA("ScreenGui") then
								topGui.Enabled = false
								topGui:Destroy()
							elseif obj.Destroy then
								obj:Destroy()
							end
						end)
					end
				end
			end
		end)
	end)

	print("RNX HUB 완전 종료됨")
end

